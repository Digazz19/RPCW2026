#################################################################
#    Classes
#################################################################

###  http://rpcw.di.uminho.pt/2026/minecraft/AmbientMob
:AmbientMob rdf:type owl:Class ;
            rdfs:subClassOf :Mob .


###  http://rpcw.di.uminho.pt/2026/minecraft/Animal
:Animal rdf:type owl:Class ;
        rdfs:subClassOf :PassiveMob .


###  http://rpcw.di.uminho.pt/2026/minecraft/Anvil
:Anvil rdf:type owl:Class ;
       rdfs:subClassOf :FunctionalBlock .


###  http://rpcw.di.uminho.pt/2026/minecraft/Armor
:Armor rdf:type owl:Class ;
       rdfs:subClassOf :Item .


###  http://rpcw.di.uminho.pt/2026/minecraft/ArmorEnchantment
:ArmorEnchantment rdf:type owl:Class ;
                  rdfs:subClassOf :Enchantment .


###  http://rpcw.di.uminho.pt/2026/minecraft/ArthropodMob
:ArthropodMob rdf:type owl:Class ;
              rdfs:subClassOf :HostileMob .


###  http://rpcw.di.uminho.pt/2026/minecraft/Axe
:Axe rdf:type owl:Class ;
     rdfs:subClassOf :Tool .


###  http://rpcw.di.uminho.pt/2026/minecraft/Beacon
:Beacon rdf:type owl:Class ;
        rdfs:subClassOf :FunctionalBlock .


###  http://rpcw.di.uminho.pt/2026/minecraft/Bed
:Bed rdf:type owl:Class ;
     rdfs:subClassOf :CraftedBlock .


###  http://rpcw.di.uminho.pt/2026/minecraft/BeneficialEffect
:BeneficialEffect rdf:type owl:Class ;
                  rdfs:subClassOf :Effect ;
                  owl:disjointWith :HarmfulEffect .


###  http://rpcw.di.uminho.pt/2026/minecraft/Biome
:Biome rdf:type owl:Class ;
       rdfs:subClassOf :Environment ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :locatedIn ;
                         owl:someValuesFrom :Dimension
                       ] .


###  http://rpcw.di.uminho.pt/2026/minecraft/Block
:Block rdf:type owl:Class ;
       rdfs:subClassOf :GameObject .


###  http://rpcw.di.uminho.pt/2026/minecraft/BlockState
